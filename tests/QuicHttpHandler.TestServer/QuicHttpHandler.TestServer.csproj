<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
    <AssemblyName>QuicHttpHandler.TestServer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../LocalhostCertificate.cs" Link="LocalhostCertificate.cs" />
  </ItemGroup>
</Project>
